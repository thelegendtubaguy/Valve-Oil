{
  "schema_version": 1,
  "path": "start_print_smart5",
  "title": "Start print (QIDI Smart 5)",
  "entrypoints": [
    {
      "name": "OrcaSlicer start (Smart 5)",
      "path": "orcaslicer_gcode/smart5/start.gcode",
      "must_include_order": [
        "SET_PRINT_MAIN_STATUS MAIN_STATUS=print_start",
        "M1002 R1",
        "G29.0",
        "OPTIMIZED_PRINT_START_HOME BEDTEMP=[bed_temperature_initial_layer_single]",
        "OPTIMIZED_START_PRINT_FILAMENT_PREP EXTRUDER=[initial_no_support_extruder] FIRSTLAYERTEMP=[nozzle_temperature_initial_layer] PURGETEMP={nozzle_temperature_range_high[initial_tool]} BEDTEMP=[bed_temperature_initial_layer_single]",
        "T[initial_tool]",
        "G90",
        "G1 Z10 F600",
        "M1006 Z{10 - ((nozzle_temperature_initial_layer[initial_tool] - 130) / 14 - 5.0) / 100}",
        "{if first_layer_print_min[1] - 10 >= print_bed_min[1]}",
        "G1 X{first_layer_print_min[0]+45} Y{first_layer_print_min[1]-10} F20000",
        "G1 X110 Y0 F20000",
        "M109 S[nozzle_temperature_initial_layer]",
        "G1 E6 F300",
        "G1 X{first_layer_print_min[0]+5} E20 F1200",
        "G1 X{first_layer_print_min[0]} E0.8",
        "G1 X70 E20 F1200",
        "G1 X65 E0.8",
        "SET_PRINT_MAIN_STATUS MAIN_STATUS=printing"
      ],
      "must_not_include": [
        "HOTENDTEMP=",
        "LOADTEMP=",
        "PURGETEMP=[nozzle_temperature_initial_layer]",
        "SET_INPUT_SHAPER",
        "G1 E-0.2 F1800",
        "BED_MESH_PROFILE",
        "tltg_start_bed_mesh_profile",
        "tltg_keep_loaded_between_prints",
        "G92_",
        "M106 P4",
        "M141",
        "CHAMBER=",
        "X180"
      ]
    },
    {
      "name": "QIDI Studio start (Smart 5)",
      "path": "qidistudio_gcode/smart5/start.gcode",
      "must_include_order": [
        "SET_PRINT_MAIN_STATUS MAIN_STATUS=print_start",
        "M1002 R1",
        "G29.0",
        "OPTIMIZED_PRINT_START_HOME BEDTEMP=[bed_temperature_initial_layer_single]",
        "OPTIMIZED_START_PRINT_FILAMENT_PREP EXTRUDER=[initial_no_support_extruder] FIRSTLAYERTEMP=[nozzle_temperature_initial_layer] PURGETEMP={nozzle_temperature_range_high[initial_tool]} BEDTEMP=[bed_temperature_initial_layer_single]",
        "T[initial_tool]",
        "G90",
        "G1 Z10 F600",
        "M1006 Z{10 - ((nozzle_temperature_initial_layer[initial_tool] - 130) / 14 - 5.0) / 100}",
        "{if first_layer_print_min[1] - 10 >= print_bed_min[1]}",
        "G1 X{first_layer_print_min[0]+45} Y{first_layer_print_min[1]-10} F20000",
        "G1 X110 Y0 F20000",
        "M109 S[nozzle_temperature_initial_layer]",
        "G1 E6 F300",
        "G1 X{first_layer_print_min[0]+5} E20 F1200",
        "G1 X{first_layer_print_min[0]} E0.8",
        "G1 X70 E20 F1200",
        "G1 X65 E0.8",
        "SET_PRINT_MAIN_STATUS MAIN_STATUS=printing"
      ],
      "must_not_include": [
        "HOTENDTEMP=",
        "LOADTEMP=",
        "PURGETEMP=[nozzle_temperature_initial_layer]",
        "SET_INPUT_SHAPER",
        "G1 E-0.2 F1800",
        "BED_MESH_PROFILE",
        "tltg_start_bed_mesh_profile",
        "tltg_keep_loaded_between_prints",
        "G92_",
        "M106 P4",
        "M141",
        "CHAMBER=",
        "X180"
      ]
    }
  ],
  "stock_config": {
    "root": "installer/stock/qidi-smart5-defaults/firmwares/01.01.02.01",
    "firmware": "smart5-01.01.02.01"
  },
  "macro_files": [
    "config/box.cfg",
    "installer/stock/qidi-smart5-defaults/firmwares/01.01.02.01/config/klipper-macros-qd/*.cfg",
    "installer/klipper/tltg-optimized-macros/*.cfg",
    "installer/klipper/printers/smart5/*.cfg"
  ],
  "branches": [
    {
      "name": "staggered_start_settings",
      "source_macro": "OPTIMIZED_PRINT_START_HOME",
      "condition": "all optimized starts",
      "slice": {
        "start": "{% set opt = printer[\"gcode_macro _tltg_optimized_globals\"] %}",
        "end": "UPDATE_DELAYED_GCODE"
      },
      "must_include_order": [
        "{% set svv = printer.save_variables.variables %}",
        "svv.tltg_staggered_start_heating|default(opt.staggered_start_heating)|int",
        "([svv.tltg_staggered_start_heating_dwell_seconds|default(opt.staggered_start_heating_dwell_seconds)|float, 0]|max)"
      ],
      "must_not_include": [
        "SAVE_VARIABLE"
      ]
    },
    {
      "name": "staggered_explicit_dispatch",
      "source_macro": "OPTIMIZED_PRINT_START_HOME",
      "condition": "staggered_start_heating && BEDTEMP or CHAMBER is provided",
      "slice": {
        "start": "{% if explicit_targets %}",
        "end": "{% else %}"
      },
      "must_include_order": [
        "_OPTIMIZED_STAGGERED_START_EXPLICIT BEDTEMP={bed_target} CHAMBER={chamber_target} PROBETEMP={probe_target} DWELL={dwell_seconds} CHAMBER_MIN_TEMP={params.CHAMBER_MIN_TEMP|default(0)|float}"
      ],
      "must_not_include": [
        "_OPTIMIZED_STAGGERED_START_ACTIVE"
      ]
    },
    {
      "name": "staggered_active_target_compatibility",
      "source_macro": "OPTIMIZED_PRINT_START_HOME",
      "condition": "staggered_start_heating && prior no-argument slicer invocation",
      "slice": {
        "start": "_OPTIMIZED_STAGGERED_START_ACTIVE PROBETEMP={probe_target} DWELL={dwell_seconds}",
        "end": "{% endif %}"
      },
      "must_include_order": [
        "_OPTIMIZED_STAGGERED_START_ACTIVE PROBETEMP={probe_target} DWELL={dwell_seconds}"
      ],
      "must_not_include": [
        "_OPTIMIZED_STAGGERED_START_EXPLICIT"
      ]
    },
    {
      "name": "concurrent_start_heating",
      "source_macro": "OPTIMIZED_PRINT_START_HOME",
      "condition": "staggered_start_heating is disabled",
      "slice": {
        "start": "{% if \"BEDTEMP\" in params %}"
      },
      "must_include_order": [
        "M140 S{bed_target}",
        "M141 S{chamber_target}",
        "M104 S{probe_target}",
        "G28"
      ],
      "must_not_include": [
        "OPTIMIZED_WAIT_BED",
        "OPTIMIZED_WAIT_CHAMBER",
        "G4 P{dwell_ms}"
      ]
    },
    {
      "name": "staggered_explicit_heating",
      "source_macro": "_OPTIMIZED_STAGGERED_START_EXPLICIT",
      "condition": "explicit targets with staggered heating enabled",
      "slice": {
        "start": "{% set bed_target = params.BEDTEMP|default(0)|float %}"
      },
      "must_include_order": [
        "M104 S0",
        "SET_HEATER_TEMPERATURE HEATER=chamber TARGET=0",
        "OPTIMIZED_WAIT_BED S={bed_target}",
        "G4 P{dwell_ms}",
        "OPTIMIZED_WAIT_CHAMBER S={chamber_target} MINIMUM={params.CHAMBER_MIN_TEMP|default(0)|float}",
        "G4 P{dwell_ms}",
        "M104 S{probe_target}"
      ],
      "must_not_include": [
        "TEMPERATURE_WAIT SENSOR=heater_bed",
        "SET_HEATER_TEMPERATURE HEATER=chamber TARGET={chamber_target}",
        "G28"
      ]
    },
    {
      "name": "staggered_active_target_heating",
      "source_macro": "_OPTIMIZED_STAGGERED_START_ACTIVE",
      "condition": "prior no-argument slicer targets with staggered heating enabled",
      "slice": {
        "start": "{% set bed_target = printer.heater_bed.target|float %}"
      },
      "must_include_order": [
        "M104 S0",
        "SET_HEATER_TEMPERATURE HEATER=chamber TARGET=0",
        "TEMPERATURE_WAIT SENSOR=heater_bed MINIMUM={([bed_target - 1, 0]|max)}",
        "G4 P{dwell_ms}",
        "SET_HEATER_TEMPERATURE HEATER=chamber TARGET={chamber_target}",
        "TEMPERATURE_WAIT SENSOR=\"heater_generic chamber\" MINIMUM={([chamber_target - 3, 0]|max)}",
        "G4 P{dwell_ms}",
        "M104 S{probe_target}"
      ],
      "must_not_include": [
        "OPTIMIZED_WAIT_BED",
        "OPTIMIZED_WAIT_CHAMBER",
        "G28"
      ]
    },
    {
      "name": "chamber_start_wait_threshold",
      "source_macro": "OPTIMIZED_WAIT_CHAMBER",
      "condition": "chamber heater available; positive minimum selects exact threshold, otherwise target minus 3 degrees",
      "slice": {
        "start": "{% if printer[\"heater_generic chamber\"] is defined %}"
      },
      "must_include_order": [
        "{% set target = params.S|default(0)|float %}",
        "{% set minimum = params.MINIMUM|default(0)|float %}",
        "{% set wait_target = ([minimum, target]|min) if minimum > 0 else ([target - 3, 0]|max) %}",
        "{% if target > 0.0 %}",
        "SET_HEATER_TEMPERATURE_SCALED HEATER=chamber TARGET={target}",
        "TEMPERATURE_WAIT SENSOR=\"heater_generic chamber\" MINIMUM={wait_target}"
      ],
      "must_not_include": [
        "TARGET={wait_target}",
        "SAVE_VARIABLE"
      ]
    },
    {
      "name": "tool_mapping_reconciliation",
      "source_macro": "OPTIMIZED_START_PRINT_FILAMENT_PREP",
      "condition": "all optimized starts",
      "slice": {
        "start": "{% set tool = params.EXTRUDER|int %}",
        "end": "{% if reuse_loaded %}"
      },
      "must_include_order": [
        "keep_loaded_between_prints = svv.tltg_keep_loaded_between_prints|default(0)|int == 1",
        "_TLTG_ENSURE_TOOL_MAPPINGS",
        "SET_GCODE_VARIABLE MACRO=OPTIMIZED_END_NOZZLE_COOLDOWN_START VARIABLE=reset_tool_mappings VALUE=0",
        "SAVE_VARIABLE VARIABLE=retained_tool_ready VALUE=0"
      ],
      "must_not_include": [
        "BOX_PRINT_START",
        "_TLTG_RESET_TOOL_MAPPINGS"
      ]
    },
    {
      "name": "retained_filament_reuse",
      "source_macro": "OPTIMIZED_START_PRINT_FILAMENT_PREP",
      "condition": "tltg_keep_loaded_between_prints == 1 and retained physical state is proven",
      "slice": {
        "start": "{% if reuse_loaded %}",
        "end": "{% elif box_enabled %}"
      },
      "must_include_order": [
        "SAVE_VARIABLE VARIABLE=retained_tool VALUE={tool}",
        "OPTIMIZED_MOVE_TO_TRASH",
        "OPTIMIZED_WAIT_BED S={bed_target} STATUS=wait_bed_temp",
        "OPTIMIZED_WAIT_CHAMBER S={chamber_target} STATUS=wait_chamber_temp MINIMUM={params.CHAMBER_MIN_TEMP|default(0)|float}",
        "OPTIMIZED_WAIT_HOTEND S={reuse_nozzle_target} STATUS=clear_nozzle",
        "OPTIMIZED_WIPE_NOZZLE_DROP",
        "{% if printer.z_tilt is defined %}",
        "_OPTIMIZED_REPORT_BED_TEMP",
        "Z_TILT_ADJUST",
        "M400",
        "_OPTIMIZED_PREPARE_PRINT_MESH",
        "M1002 A1",
        "ENABLE_ALL_SENSOR"
      ],
      "must_not_include": [
        "BOX_PRINT_START",
        "OPTIMIZED_EXTRUSION_AND_FLUSH",
        "OPTIMIZED_WIPE_AND_SCRAPE_NOZZLE",
        "PATTERN=MIXED",
        "_OPTIMIZED_REAR_BED_SCRAPE",
        "_OPTIMIZED_FINISH_START_SCRAPE",
        "CLEAR_NOZZLE"
      ]
    },
    {
      "name": "box_fresh_load",
      "source_macro": "OPTIMIZED_START_PRINT_FILAMENT_PREP",
      "condition": "box_enabled and retention is disabled or retained physical state is not proven",
      "slice": {
        "start": "{% elif box_enabled %}",
        "end": "{% else %}"
      },
      "must_include_order": [
        "SET_PRINT_SUB_STATUS SUB_STATUS=change_filament",
        "BOX_PRINT_START EXTRUDER={tool} HOTENDTEMP={purge_temp}",
        "OPTIMIZED_EXTRUSION_AND_FLUSH PURGETEMP={purge_temp} CHAMBER={chamber_target} PRE_SCRAPE=1",
        "{% if purge_temp > scrape_target %}",
        "TEMPERATURE_WAIT SENSOR=extruder MAXIMUM={purge_temp}",
        "OPTIMIZED_WIPE_NOZZLE_DROP PATTERN=MIXED",
        "{% if purge_temp - 30 > scrape_target %}",
        "TEMPERATURE_WAIT SENSOR=extruder MAXIMUM={purge_temp - 30}",
        "OPTIMIZED_WIPE_NOZZLE_DROP PATTERN=MIXED",
        "TEMPERATURE_WAIT SENSOR=extruder MAXIMUM={scrape_maximum}",
        "OPTIMIZED_WIPE_NOZZLE_DROP PATTERN=MIXED",
        "_OPTIMIZED_REAR_BED_SCRAPE",
        "_OPTIMIZED_FINISH_START_SCRAPE",
        "OPTIMIZED_WAIT_BED S={bed_target} STATUS=wait_bed_temp",
        "OPTIMIZED_WAIT_CHAMBER S={chamber_target} STATUS=wait_chamber_temp MINIMUM={params.CHAMBER_MIN_TEMP|default(0)|float}",
        "G1 X{profile.z_tilt_staging_x} Y{profile.z_tilt_staging_y} F33900",
        "{% if printer.z_tilt is defined %}",
        "_OPTIMIZED_REPORT_BED_TEMP",
        "Z_TILT_ADJUST",
        "M400",
        "_OPTIMIZED_PREPARE_PRINT_MESH",
        "M1002 A1",
        "ENABLE_ALL_SENSOR"
      ],
      "must_not_include": [
        "CLEAR_NOZZLE",
        "OPTIMIZED_WIPE_AND_SCRAPE_NOZZLE"
      ]
    },
    {
      "name": "no_box_external_spool",
      "source_macro": "OPTIMIZED_START_PRINT_FILAMENT_PREP",
      "condition": "!box_available || !enable_box",
      "slice": {
        "start": "{% else %}"
      },
      "must_include_order": [
        "M118 Starting without QIDI Box filament prep",
        "OPTIMIZED_WIPE_AND_SCRAPE_NOZZLE TARGET={scrape_target}",
        "OPTIMIZED_WAIT_BED S={bed_target} STATUS=wait_bed_temp",
        "OPTIMIZED_WAIT_CHAMBER S={chamber_target} STATUS=wait_chamber_temp MINIMUM={params.CHAMBER_MIN_TEMP|default(0)|float}",
        "{% if printer.z_tilt is defined %}",
        "_OPTIMIZED_REPORT_BED_TEMP",
        "Z_TILT_ADJUST",
        "M400",
        "_OPTIMIZED_PREPARE_PRINT_MESH",
        "M1002 A1",
        "ENABLE_ALL_SENSOR"
      ],
      "must_not_include": [
        "BOX_PRINT_START",
        "OPTIMIZED_EXTRUSION_AND_FLUSH",
        "_OPTIMIZED_WIPE_NOZZLE",
        "CLEAR_NOZZLE",
        "G1 E250"
      ]
    },
    {
      "name": "saved_mesh_profile",
      "source_macro": "_OPTIMIZED_PREPARE_PRINT_MESH",
      "condition": "tltg_start_bed_mesh_profile is non-empty",
      "slice": {
        "start": "{% if profile %}",
        "end": "{% else %}"
      },
      "must_include_order": [
        "action_respond_info(\"Loading saved bed mesh profile: %s\" % profile)",
        "G32",
        "SET_STEPPER_ENABLE STEPPER=extruder enable=0",
        "BED_MESH_CLEAR",
        "BED_MESH_PROFILE LOAD=\"{command_profile}\""
      ],
      "must_not_include": [
        "_OPTIMIZED_G29_HOME_Z_OR_FULL",
        "BED_MESH_CALIBRATE",
        "SAVE_CONFIG_QD"
      ]
    },
    {
      "name": "fresh_adaptive_mesh",
      "source_macro": "_OPTIMIZED_PREPARE_PRINT_MESH",
      "condition": "tltg_start_bed_mesh_profile is absent or empty",
      "slice": {
        "start": "{% else %}"
      },
      "must_include_order": [
        "action_respond_info(\"Calibrating fresh adaptive KAMP bed mesh\")",
        "G31",
        "SET_STEPPER_ENABLE STEPPER=extruder enable=0",
        "BED_MESH_CLEAR",
        "_OPTIMIZED_G29_HOME_Z_OR_FULL",
        "BED_MESH_CALIBRATE PROFILE=kamp",
        "SAVE_VARIABLE VARIABLE=profile_name VALUE='\"kamp\"'",
        "G4 P500",
        "TLTG_SAVE_CONFIG_QD"
      ],
      "must_not_include": [
        "BED_MESH_PROFILE LOAD="
      ]
    },
    {
      "name": "start_pre_scrape_mixed_speed_wipe",
      "source_macro": "_OPTIMIZED_START_PRE_SCRAPE_WIPE",
      "condition": "fresh Box or external-spool start pre-scrape wipe with the nozzle already in the chute",
      "slice": {
        "start": "{% set saved_accel = printer.toolhead.max_accel|float %}"
      },
      "must_include_order": [
        "SAVE_GCODE_STATE NAME=optimized_start_pre_scrape_wipe_state",
        "G90",
        "M204 S5000",
        "{% for i in range(5) %}",
        "G1 Y{km.park_y - 19} F10000",
        "G1 Y{km.park_y} F6000",
        "{% endfor %}",
        "G1 X66 F3000",
        "G1 X{km.park_x}",
        "M400",
        "SET_VELOCITY_LIMIT ACCEL={saved_accel}",
        "RESTORE_GCODE_STATE NAME=optimized_start_pre_scrape_wipe_state"
      ],
      "must_not_include": [
        " E",
        "G1 Z",
        "G4 ",
        "M104",
        "M109",
        "CLEAR_NOZZLE",
        "CLEAR_OOZE",
        "CLEAR_FLUSH",
        "_OPTIMIZED_REAR_BED_SCRAPE"
      ]
    },
    {
      "name": "chute_wiper_strokes",
      "source_macro": "_OPTIMIZED_WIPE_NOZZLE",
      "condition": "optimized cleanup with the nozzle already in the chute",
      "slice": {
        "start": "{% set saved_accel = printer.toolhead.max_accel|float %}"
      },
      "must_include_order": [
        "SAVE_GCODE_STATE NAME=optimized_wipe_nozzle_state",
        "G90",
        "M204 S10000",
        "{% for i in range(5) %}",
        "G1 Y{km.park_y - 19} F10000",
        "G1 Y{km.park_y} F6000",
        "{% endfor %}",
        "M400",
        "SET_VELOCITY_LIMIT ACCEL={saved_accel}",
        "RESTORE_GCODE_STATE NAME=optimized_wipe_nozzle_state"
      ],
      "must_not_include": [
        " E",
        "G1 Z",
        "G4 ",
        "M104",
        "M109",
        "CLEAR_NOZZLE",
        "CLEAR_OOZE",
        "_OPTIMIZED_REAR_BED_SCRAPE",
        "G1 X"
      ]
    },
    {
      "name": "chute_wipe_and_drop_dispatch",
      "source_macro": "OPTIMIZED_WIPE_NOZZLE_DROP",
      "condition": "PATTERN=MIXED selects the print-start pre-scrape wipe; omitted or other values select the fast silicone wipe; both release waste through the optimized chute drop",
      "slice": {
        "start": "{% if params.PATTERN|default(\"FAST\")|upper == \"MIXED\" %}"
      },
      "must_include_order": [
        "{% if params.PATTERN|default(\"FAST\")|upper == \"MIXED\" %}",
        "_OPTIMIZED_START_PRE_SCRAPE_WIPE",
        "{% else %}",
        "_OPTIMIZED_WIPE_NOZZLE",
        "{% endif %}",
        "_OPTIMIZED_CHUTE_DROP"
      ],
      "must_not_include": [
        "CLEAR_FLUSH",
        "CLEAR_OOZE",
        "CLEAR_NOZZLE",
        "DROP_TRASH",
        " E",
        "G4 "
      ]
    },
    {
      "name": "chute_waste_release",
      "source_macro": "_OPTIMIZED_CHUTE_DROP",
      "condition": "optimized cleanup sweeping across the chute so wiped waste drops",
      "slice": {
        "start": "{% set saved_accel = printer.toolhead.max_accel|float %}"
      },
      "must_include_order": [
        "SAVE_GCODE_STATE NAME=optimized_chute_drop_state",
        "G90",
        "M204 S10000",
        "OPTIMIZED_MOVE_TO_TRASH",
        "G1 X66 F6000",
        "G1 X90 F6000",
        "G1 X66 F3000",
        "G1 X90 Y{km.park_y - 20} F10000",
        "OPTIMIZED_MOVE_TO_TRASH",
        "SET_VELOCITY_LIMIT ACCEL={saved_accel}",
        "RESTORE_GCODE_STATE NAME=optimized_chute_drop_state"
      ],
      "must_not_include": [
        "CLEAR_FLUSH",
        "CLEAR_OOZE",
        "DROP_TRASH",
        " E",
        "G1 Z",
        "G4 ",
        "M104",
        "M109"
      ]
    },
    {
      "name": "rear_bed_scrape_motion",
      "source_macro": "_OPTIMIZED_REAR_BED_SCRAPE",
      "condition": "fresh Box or external-spool scrape on the strip behind the bed, just above where the probe touches it",
      "slice": {
        "start": "{% set km = printer[\"gcode_macro _km_globals\"] %}"
      },
      "must_include_order": [
        "OPTIMIZED_MOVE_TO_TRASH",
        "M204 S10000",
        "G1 X79 Y187 F12000",
        "G1 Z5 F480",
        "PROBE SAMPLES=1",
        "G1 Z0.1 F480",
        "G2 I0.5 J0.5 F600",
        "G1 X85 Y185 F12000",
        "G1 Z-1 F600",
        "G1 X95 F200",
        "G1 Y186",
        "G1 X85",
        "G1 Y187",
        "G1 X95",
        "G1 Z10 F600",
        "G1 Y{km.park_y - 20} F10000",
        "SET_VELOCITY_LIMIT ACCEL={saved_accel}"
      ],
      "must_not_include": [
        "rear_scrape_orient_speed_xy",
        "G1 Z-0.2"
      ]
    },
    {
      "name": "external_spool_start_cleanup",
      "source_macro": "OPTIMIZED_WIPE_AND_SCRAPE_NOZZLE",
      "condition": "external-spool start, with optional vendor chute cleanup guarded by Box object availability",
      "slice": {
        "start": "{% set scrape_target = params.TARGET|default(km.start_extruder_probing_temp if km.start_extruder_probing_temp > 0 else 140)|int %}"
      },
      "must_include_order": [
        "box_available = printer.tltg_macro_status.box_available",
        "OPTIMIZED_WAIT_HOTEND S={scrape_target} STATUS=clear_nozzle",
        "TEMPERATURE_WAIT SENSOR={printer.toolhead.extruder} MAXIMUM={scrape_maximum}",
        "{% if box_available %}",
        "OPTIMIZED_WIPE_NOZZLE_DROP PATTERN=MIXED",
        "{% endif %}",
        "_OPTIMIZED_REAR_BED_SCRAPE",
        "_OPTIMIZED_FINISH_START_SCRAPE"
      ],
      "must_not_include": [
        "BOX_PRINT_START",
        "OPTIMIZED_EXTRUSION_AND_FLUSH",
        "_OPTIMIZED_WIPE_NOZZLE",
        "G1 E",
        "CLEAR_NOZZLE",
        "CLEAR_FLUSH"
      ]
    },
    {
      "name": "post_scrape_chute_finish",
      "source_macro": "_OPTIMIZED_FINISH_START_SCRAPE",
      "condition": "fresh Box or external-spool scrape complete and vendor chute cleanup object available",
      "slice": {
        "start": "{% set box_available = printer.tltg_macro_status.box_available %}"
      },

{
  "schema_version": 1,
  "path": "print_offset",
  "title": "Z offset across a print",
  "entrypoints": [],
  "macro_files": [
    "config/box.cfg",
    "config/klipper-macros-qd/*.cfg",
    "installer/klipper/macros/*.cfg",
    "installer/klipper/printers/max4/*.cfg"
  ],
  "branches": [
    {
      "name": "capture_saved_offset_and_zero",
      "source_macro": "_KM_APPLY_PRINT_OFFSET",
      "condition": "print start, before the nozzle is probed",
      "slice": {
        "start": "{% if params.RESET|default(0)|int %}",
        "end": "{% elif params.SET|default(0)|int %}"
      },
      "must_include_order": [
        "printer.save_variables.variables.z_offset|default(0)|float",
        "SET_GCODE_VARIABLE MACRO=_km_apply_print_offset VARIABLE=captured_z_offset VALUE={z}",
        "SET_GCODE_VARIABLE MACRO=_km_apply_print_offset VARIABLE=captured_z_offset_valid VALUE=1",
        "SET_GCODE_VARIABLE MACRO=_km_apply_print_offset VARIABLE=print_offset_applied VALUE=0",
        "SET_GCODE_OFFSET Z=0 MOVE=0"
      ],
      "must_not_include": [
        "SAVE_VARIABLE"
      ]
    },
    {
      "name": "apply_captured_offset",
      "source_macro": "_KM_APPLY_PRINT_OFFSET",
      "condition": "print start, after probing",
      "slice": {
        "start": "{% elif params.SET|default(0)|int %}",
        "end": "{% elif params.SAVE|default(0)|int %}"
      },
      "must_include_order": [
        "{% if captured_z_offset_valid|int %}",
        "SET_GCODE_OFFSET Z={z} MOVE=0",
        "SET_GCODE_VARIABLE MACRO=_km_apply_print_offset VARIABLE=print_offset_applied VALUE=1"
      ],
      "must_not_include": [
        "SAVE_VARIABLE"
      ]
    },
    {
      "name": "save_only_an_applied_offset",
      "source_macro": "_KM_APPLY_PRINT_OFFSET",
      "condition": "print end; a print that ended before the offset was applied saves nothing",
      "slice": {
        "start": "{% elif params.SAVE|default(0)|int %}"
      },
      "must_include_order": [
        "{% if not print_offset_applied|int %}",
        "{% elif printer.gcode_move.homing_origin.z < 0.5 %}",
        "SAVE_VARIABLE VARIABLE=z_offset VALUE={printer.gcode_move.homing_origin.z}"
      ],
      "must_not_include": [
        "SET_GCODE_OFFSET",
        "{% else %}"
      ]
    }
  ],
  "generated": {
    "markdown": "openspec/contracts/gcode-paths/generated/print-offset.md",
    "mermaid": "openspec/contracts/gcode-paths/generated/print-offset.mmd"
  }

  ],
  "branches": [
    {
      "name": "retained_filament_record",
      "source_macro": "OPTIMIZED_END_PRINT_FILAMENT_PREP",
      "condition": "keep filament loaded between prints is on, the Box is in use, and filament is at the toolhead",
      "slice": {
        "start": "{% if keep_loaded %}",
        "end": "{% else %}"
      },
      "must_include_order": [
        "SET_GCODE_VARIABLE MACRO=OPTIMIZED_END_PRINT_FILAMENT_PREP VARIABLE=retained VALUE=1",
        "SAVE_VARIABLE VARIABLE=retained_tool VALUE={active_tool.value}",
        "SAVE_VARIABLE VARIABLE=retained_tool_ready VALUE=1",
        "SAVE_VARIABLE VARIABLE=retained_slot VALUE='\"{active_slot}\"'",
        "SAVE_VARIABLE VARIABLE=retained_filament_id VALUE='\"{active_filament_id}\"'",
        "SAVE_VARIABLE VARIABLE=retained_vendor_id VALUE={active_vendor_id}"
      ],
      "must_not_include": [
        "VO_UNLOAD_FILAMENT",
        "G1 E",
        "VALUE={tool}",
        "{tool_slot}"
      ]
    },
    {
      "name": "end_retract_and_unload",
      "source_macro": "OPTIMIZED_END_PRINT_FILAMENT_PREP",
      "condition": "filament is not kept loaded for the next print",
      "slice": {
        "start": "{% else %}"
      },
      "must_include_order": [
        "SET_GCODE_VARIABLE MACRO=OPTIMIZED_END_PRINT_FILAMENT_PREP VARIABLE=retained VALUE=0",
        "DISABLE_ALL_SENSOR",
        "SAVE_VARIABLE VARIABLE=retained_tool VALUE=-1",
        "SAVE_GCODE_STATE NAME=vo_end_print_filament_prep_state",
        "M83",
        "G1 E-3 F1800",
        "RESTORE_GCODE_STATE NAME=vo_end_print_filament_prep_state",
        "VO_UNLOAD_FILAMENT T={tool} CLEANUP=0",
        "{% endif %}",
        "SET_GCODE_VARIABLE MACRO=OPTIMIZED_END_NOZZLE_COOLDOWN_START VARIABLE=reset_tool_mappings VALUE=1"
      ],
      "must_not_include": [
        "_VO_RESET_TOOL_MAPPINGS",
        "VO_WIPE_NOZZLE_DROP"
      ]
    },
    {
      "name": "end_heaters_off_then_fan_cooldown",
      "source_macro": "OPTIMIZED_END_NOZZLE_COOLDOWN_START",
      "condition": "every print end; tool mappings reset only after a print that ended normally",
      "slice": {
        "start": "M106 S255"
      },
      "must_include_order": [
        "M106 S255",
        "exhaust_speed = params.EXHAUST_SPEED|default(0)|int",
        "VO_DISABLE_BOX_HEATER",
        "M141 S0",
        "M140 S0",
        "M104 S0",
        "VO_END_FAN_COOLDOWN S={exhaust_speed} T={exhaust_duration}",
        "{% if reset_tool_mappings %}",
        "SET_GCODE_VARIABLE MACRO=OPTIMIZED_END_NOZZLE_COOLDOWN_START VARIABLE=reset_tool_mappings VALUE=0",
        "{% if normal_print_active %}",
        "_VO_RESET_TOOL_MAPPINGS"
      ],
      "must_not_include": [
        "TEMPERATURE_WAIT",
        "M109",
        "M190",
        "VO_WIPE_NOZZLE_DROP"
      ]
    },
    {
      "name": "staged_cooldown_wipes",
      "source_macro": "OPTIMIZED_END_STAGED_NOZZLE_WIPE",
      "condition": "after the cooldown starts; each wipe waits for the nozzle to cool to its stage",
      "slice": {
        "start": "SET_PRINT_SUB_STATUS SUB_STATUS=clear_nozzle"
      },
      "must_include_order": [
        "TEMPERATURE_WAIT SENSOR={extruder} MAXIMUM={first_wipe_temp}",
        "VO_WIPE_NOZZLE_DROP",
        "TEMPERATURE_WAIT SENSOR={extruder} MAXIMUM={final_wipe_temp}",
        "VO_WIPE_NOZZLE_DROP",
        "SAVE_GCODE_STATE NAME=vo_end_staged_nozzle_wipe_state",
        "G91",
        "G1 Y-{pull_forward_y} F6000",
        "RESTORE_GCODE_STATE NAME=vo_end_staged_nozzle_wipe_state"
      ],
      "must_not_include": [
        "PATTERN=MIXED",
        "M104",
        "M109",
        "G1 E",
        "_VO_REAR_BED_SCRAPE"
      ]
    },
    {
      "name": "end_cleanup_alias",
      "source_macro": "VO_END_NOZZLE_CLEANUP",
      "condition": "older slicer packs' single end-cleanup command",
      "slice": {
        "start": "OPTIMIZED_MOVE_TO_TRASH"
      },
      "must_include_order": [
        "OPTIMIZED_MOVE_TO_TRASH",
        "OPTIMIZED_END_NOZZLE_COOLDOWN_START {rawparams}",
        "OPTIMIZED_END_STAGED_NOZZLE_WIPE"
      ],
      "must_not_include": [
        "VO_END_FAN_COOLDOWN"
      ]
    },
    {
      "name": "manual_tool_mapping_reset_needs_an_idle_printer",
      "source_macro": "VO_RESET_TOOL_MAPPINGS",
      "condition": "an operator resets the tool mappings from the console",
      "slice": {
        "start": "{% set print_active ="
      },
      "must_include_order": [
        "printer.idle_timeout.state|string == \"Printing\" or",
        "(printer.virtual_sdcard|default({})).is_active|default(False) or",
        "printer.pause_resume.is_paused %}",
        "{% if print_active %}",
        "action_raise_error(",
        "{% else %}",
        "_VO_RESET_TOOL_MAPPINGS REPORT=1"
      ],
      "must_not_include": [
        "SAVE_VARIABLE"
      ]
    },
    {
      "name": "cancel_on_error_without_moving",
      "source_macro": "VO_CANCEL_PRINT_ON_ERROR",
      "condition": "a print error cancels the print where the toolhead is",
      "slice": {
        "start": "SET_GCODE_VARIABLE MACRO=_print_end_inner VARIABLE=cancelled"
      },
      "must_include_order": [
        "M104 S0",
        "M140 S0",
        "M141 S0",
        "VO_DISABLE_BOX_HEATER",
        "M106 P4 S0",
        "G31",
        "CLEAR_PAUSE",
        "_KM_CANCEL_PRINT_BASE"
      ],
      "must_not_include": [
        "G0 ",
        "G1 ",
        "G28",
        "OPTIMIZED_MOVE_TO_TRASH",
        "_VO_RESET_TOOL_MAPPINGS"
      ]
    }
